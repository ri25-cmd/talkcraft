# Copy to .env.local (gitignored) and fill in your RevenueCat PUBLIC SDK keys.
# Find them at: RevenueCat dashboard -> Project Settings -> API keys.
#
# Use the PUBLIC SDK keys only. They are designed to ship inside the app.
# The secret key (sk_...) must NEVER appear in this file or anywhere in the app;
# it is for server-to-server use only. The app refuses to start billing if it
# detects a secret key here.
# Option A - RevenueCat Test Store (development builds only).
# One key covers both platforms. Requires react-native-purchases >= 9.5.4.
# A release build configured with a test_ key is refused by this app, because
# the SDK crashes on purpose in that situation.
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_YOUR_TEST_STORE_KEY
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=test_YOUR_TEST_STORE_KEY

# Option B - real platform keys, required before shipping.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_PUBLIC_ANDROID_SDK_KEY
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_PUBLIC_IOS_SDK_KEY
